{
  "name": "aulas",
  "version": "1.0.0",
  "private": true,
  "description": "Player de videoaulas com controle de progresso",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "typecheck": "tsc && vue-tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "music-metadata": "^11.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "pinia": "^4.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.7",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  }
}
